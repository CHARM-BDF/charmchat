// Generated by lsc from workflow.ts

datatype Option<T> = None | Some(value: T)

method SetToSeq<T>(s: set<T>) returns (res: seq<T>)
  ensures forall x :: x in s <==> x in res
  ensures |res| == |s|
{
  var remaining := s;
  res := [];
  while remaining != {}
    invariant remaining <= s
    invariant forall x :: x in res <==> (x in s && x !in remaining)
    invariant |res| + |remaining| == |s|
    decreases remaining
  {
    var x :| x in remaining;
    res := res + [x];
    remaining := remaining - {x};
  }
}

datatype WorkflowNode = WorkflowNode(id: string, tool: string, args: map<string, int>)

method topologicalSort(nodes: seq<WorkflowNode>, deps: map<string, set<string>>) returns (res: seq<WorkflowNode>)
  ensures (|res| <= |nodes|)
{
  var nodeMap := map[];
  var i_n_idx := 0;
  while i_n_idx < |nodes|
    invariant (i_n_idx <= |nodes|)
    invariant forall ki: int :: ((ki >= 0) ==> (ki < i_n_idx) ==> (nodes[ki].id in nodeMap))
  {
    var n := nodes[i_n_idx];
    nodeMap := nodeMap[n.id := n];
    i_n_idx := i_n_idx + 1;
  }
  var inDegree := map[];
  var adjacency := map[];
  ghost var remDeps: map<string, set<string>> := map[];
  ghost var processed: set<string> := {};
  var i_node_idx := 0;
  while i_node_idx < |nodes|
    invariant (i_node_idx <= |nodes|)
  {
    var node := nodes[i_node_idx];
    inDegree := inDegree[node.id := 0];
    adjacency := adjacency[node.id := []];
    remDeps := remDeps[node.id := {}];
    i_node_idx := i_node_idx + 1;
  }
  var i_nodeId_keys := SetToSeq(deps.Keys);
  var i_nodeId_idx := 0;
  while i_nodeId_idx < |i_nodeId_keys|
    invariant (i_nodeId_idx <= |i_nodeId_keys|)
  {
    var nodeId := i_nodeId_keys[i_nodeId_idx];
    var nodeDeps := deps[nodeId];
    inDegree := inDegree[nodeId := |nodeDeps|];
    remDeps := remDeps[nodeId := nodeDeps];
    var i_dep_seq := SetToSeq(nodeDeps);
    var i_dep_idx := 0;
    while i_dep_idx < |i_dep_seq|
      invariant (i_dep_idx <= |i_dep_seq|)
    {
      var dep := i_dep_seq[i_dep_idx];
      if (dep in adjacency) {
        adjacency := adjacency[dep := (adjacency[dep] + [nodeId])];
      }
      i_dep_idx := i_dep_idx + 1;
    }
    i_nodeId_idx := i_nodeId_idx + 1;
  }
  var queue := [];
  var i_id_keys := SetToSeq(inDegree.Keys);
  var i_id_idx := 0;
  while i_id_idx < |i_id_keys|
    invariant (i_id_idx <= |i_id_keys|)
  {
    var id := i_id_keys[i_id_idx];
    var degree := inDegree[id];
    if (degree == 0) {
      queue := (queue + [id]);
    }
    i_id_idx := i_id_idx + 1;
  }
  var sorted := [];
  while (|queue| > 0)
  {
    var id := queue[0];
    queue := queue[1..];
    sorted := (sorted + [nodeMap[id]]);
    var i_neighbor_idx := 0;
    while i_neighbor_idx < |(match (if id in adjacency then Some(adjacency[id]) else None) { case Some(i_value) => i_value case None => [] })|
      invariant (i_neighbor_idx <= |(match (if id in adjacency then Some(adjacency[id]) else None) { case Some(i_value) => i_value case None => [] })|)
    {
      var neighbor := (match (if id in adjacency then Some(adjacency[id]) else None) { case Some(i_value) => i_value case None => [] })[i_neighbor_idx];
      var newDegree := ((match (if neighbor in inDegree then Some(inDegree[neighbor]) else None) { case Some(i_value) => i_value case None => 0 }) - 1);
      inDegree := inDegree[neighbor := newDegree];
      remDeps := remDeps[neighbor := (remDeps[neighbor] - {id})];
      if (newDegree == 0) {
        queue := (queue + [neighbor]);
      }
      i_neighbor_idx := i_neighbor_idx + 1;
    }
    processed := (processed + {id});
  }
  if (|sorted| != |nodes|) {
    assert false;
  }
  return sorted;
}
