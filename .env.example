ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_HOST=http://localhost:11434
PORT=3001

# Lock the app to a single provider:model (e.g. vertex:claude-sonnet-4-6)
FIXED_MODEL=

# Restrict the app to a subset of providers (comma-separated).
# e.g. FIXED_PROVIDERS=anthropic,openai,gemini   (omits bedrock, vertex, ollama)
# Ignored when FIXED_MODEL is set.
FIXED_PROVIDERS=

NCBI_API_KEY=

# ToolUniverse (optional — most tools work without keys, but with rate limits)
SEMANTIC_SCHOLAR_API_KEY=
FDA_API_KEY=
